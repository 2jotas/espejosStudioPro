FROM node:20-alpine AS builder
RUN apk add --no-cache openssl libc6-compat git python3 make g++

WORKDIR /app

# Copy root configs
COPY package*.json ./
COPY packages ./packages
COPY apps/api/package*.json ./apps/api/
COPY apps/api/prisma ./apps/api/prisma

# Install dependencies
RUN npm install

# Copy source code
COPY apps/api ./apps/api
COPY packages ./packages

# Build shared types package first
RUN npm run build --workspace=@espejos/shared-types

# Generate Prisma Client
WORKDIR /app/apps/api
RUN npx prisma generate

EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000

# Protect production data: sync schema without data loss and start Fastify server
CMD ["sh", "-c", "npx prisma db push --skip-generate && npx tsx src/server.ts"]
