generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Professional {
  id                      String         @id @default(uuid())
  slug                    String         @unique
  email                   String         @unique
  passwordHash            String         @map("password_hash")
  businessName            String         @map("business_name")
  phone                   String?
  address                 String?
  whatsapp                String?
  bio                     String?
  plan                    String         @default("free") // "free" | "pro"
  planExpiresAt           DateTime?      @map("plan_expires_at")
  googleCalendarConnected Boolean        @default(false) @map("google_calendar_connected")
  googleRefreshToken      String?        @map("google_refresh_token")
  googleCalendarId        String?        @map("google_calendar_id")
  googleApiKey            String?        @map("google_api_key")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  clients                 Client[]
  clientProfiles          ClientProfile[]
  services                Service[]
  appointments            Appointment[]
  galleryImages           GalleryImage[]

  @@map("professionals")
}

model Client {
  id             String               @id @default(uuid())
  professionalId String               @map("professional_id")
  firstName      String               @map("first_name")
  lastName       String               @map("last_name")
  phone          String
  authMethod     String               @default("otp") @map("auth_method") // "passkey" | "otp"
  createdAt      DateTime             @default(now()) @map("created_at")

  professional   Professional         @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  profile        ClientProfile?
  appointments   Appointment[]
  webauthnCreds  WebAuthnCredential[]

  @@unique([professionalId, phone])
  @@map("clients")
}

model ClientProfile {
  id             String       @id @default(uuid())
  clientId       String       @unique @map("client_id")
  professionalId String       @map("professional_id")
  notes          String?
  preferences    String? // JSON stringified object
  tags           String       @default("[]") // JSON stringified array for SQLite compatibility
  lastVisitAt    DateTime?    @map("last_visit_at")
  visitCount     Int          @default(0) @map("visit_count")
  totalSpent     Float        @default(0) @map("total_spent")

  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model Service {
  id              String        @id @default(uuid())
  professionalId  String        @map("professional_id")
  name            String
  description     String?
  durationMinutes Int           @map("duration_minutes")
  price           Float
  active          Boolean       @default(true)
  order           Int           @default(0)

  professional    Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@map("services")
}

model Appointment {
  id                   String       @id @default(uuid())
  professionalId       String       @map("professional_id")
  clientId             String       @map("client_id")
  serviceId            String       @map("service_id")
  startsAt             DateTime     @map("starts_at")
  endsAt               DateTime     @map("ends_at")
  status               String       @default("pending") // "pending" | "confirmed" | "cancelled" | "completed" | "no_show"
  clientNote           String?      @map("client_note")
  clientPhotoUrl       String?      @map("client_photo_url")
  googleCalendarEventId String?     @map("google_calendar_event_id")
  createdAt            DateTime     @default(now()) @map("created_at")

  professional         Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  client               Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service              Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model GalleryImage {
  id             String       @id @default(uuid())
  professionalId String       @map("professional_id")
  filePath       String       @map("file_path")
  source         String       @default("upload") // "upload" | "watched_folder"
  caption        String?
  createdAt      DateTime     @default(now()) @map("created_at")

  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("gallery_images")
}

model WebAuthnCredential {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  credentialId String   @unique @map("credential_id")
  publicKey    String   @map("public_key")
  counter      BigInt   @default(0)
  deviceLabel  String?  @map("device_label")

  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("webauthn_credentials")
}
