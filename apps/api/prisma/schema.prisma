generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Professional {
  id                      String         @id @default(uuid())
  slug                    String         @unique
  email                   String         @unique
  passwordHash            String         @map("password_hash")
  businessName            String         @map("business_name")
  phone                   String?
  address                 String?
  whatsapp                String?
  bio                     String?
  plan                    String         @default("free") // "free" | "pro"
  planExpiresAt           DateTime?      @map("plan_expires_at")
  googleCalendarConnected Boolean        @default(false) @map("google_calendar_connected")
  googleRefreshToken      String?        @map("google_refresh_token")
  googleCalendarId        String?        @map("google_calendar_id")
  googleApiKey            String?        @map("google_api_key")
  visagismEnabled         Boolean        @default(true) @map("visagism_enabled")
  whatsappConnected       Boolean        @default(false) @map("whatsapp_connected")
  whatsappSessionId       String?        @map("whatsapp_session_id")
  whatsappBotEnabled      Boolean        @default(true) @map("whatsapp_bot_enabled")
  whatsappTone            String         @default("cercano") @map("whatsapp_tone")
  whatsappCustomPrompt    String?        @map("whatsapp_custom_prompt")
  whatsappFewShotExamples String?        @map("whatsapp_few_shot_examples")
  whatsappReminderHours   Int            @default(2) @map("whatsapp_reminder_hours")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  clients                 Client[]
  clientProfiles          ClientProfile[]
  services                Service[]
  appointments            Appointment[]
  galleryImages           GalleryImage[]
  visagismConsultations   VisagismConsultation[]
  whatsappMessageLogs     WhatsAppMessageLog[]

  @@map("professionals")
}

model Client {
  id             String               @id @default(uuid())
  professionalId String               @map("professional_id")
  firstName      String               @map("first_name")
  lastName       String               @map("last_name")
  phone          String
  authMethod     String               @default("otp") @map("auth_method") // "passkey" | "otp"
  createdAt      DateTime             @default(now()) @map("created_at")

  professional   Professional         @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  profile        ClientProfile?
  appointments   Appointment[]
  webauthnCreds  WebAuthnCredential[]

  @@unique([professionalId, phone])
  @@map("clients")
}

model ClientProfile {
  id             String       @id @default(uuid())
  clientId       String       @unique @map("client_id")
  professionalId String       @map("professional_id")
  notes          String?
  preferences    String? // JSON stringified object
  tags           String       @default("[]") // JSON stringified array for SQLite compatibility
  lastVisitAt    DateTime?    @map("last_visit_at")
  visitCount     Int          @default(0) @map("visit_count")
  totalSpent     Float        @default(0) @map("total_spent")

  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model Service {
  id              String        @id @default(uuid())
  professionalId  String        @map("professional_id")
  name            String
  description     String?
  durationMinutes Int           @map("duration_minutes")
  price           Float
  active          Boolean       @default(true)
  order           Int           @default(0)

  professional    Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@map("services")
}

model Appointment {
  id                    String       @id @default(uuid())
  professionalId        String       @map("professional_id")
  clientId              String       @map("client_id")
  serviceId             String       @map("service_id")
  startsAt              DateTime     @map("starts_at")
  endsAt                DateTime     @map("ends_at")
  status                String       @default("pending") // "pending" | "confirmed" | "cancelled" | "completed" | "no_show"
  whatsappStatus        String       @default("pendiente") @map("whatsapp_status") // "pendiente" | "confirmada" | "cancelada" | "reagendada"
  whatsappReminderSentAt DateTime?   @map("whatsapp_reminder_sent_at")
  clientNote            String?      @map("client_note")
  clientPhotoUrl        String?      @map("client_photo_url")
  googleCalendarEventId String?      @map("google_calendar_event_id")
  createdAt             DateTime     @default(now()) @map("created_at")

  professional          Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  client                Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service               Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model WhatsAppMessageLog {
  id             String       @id @default(uuid())
  professionalId String       @map("professional_id")
  phone          String
  role           String       // "user" | "assistant" | "system"
  content        String
  timestamp      DateTime     @default(now())

  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, phone])
  @@map("whatsapp_message_logs")
}

model GalleryImage {
  id             String       @id @default(uuid())
  professionalId String       @map("professional_id")
  filePath       String       @map("file_path")
  source         String       @default("upload") // "upload" | "watched_folder"
  caption        String?
  createdAt      DateTime     @default(now()) @map("created_at")

  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("gallery_images")
}

model WebAuthnCredential {
  id           String   @id @default(uuid())
  clientId     String   @map("client_id")
  credentialId String   @unique @map("credential_id")
  publicKey    String   @map("public_key")
  counter      BigInt   @default(0)
  deviceLabel  String?  @map("device_label")

  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("webauthn_credentials")
}

model VisagismConsultation {
  id                   String       @id @default(uuid())
  professionalId       String       @map("professional_id")
  ageGroup             String       @map("age_group")
  occupation           String
  maintenanceTime      String       @map("maintenance_time")
  faceShape            String       @map("face_shape")
  hairType             String       @map("hair_type")
  skinTone             String       @map("skin_tone")
  recommendationsJson  String       @map("recommendations_json")
  editPrompt           String?      @map("edit_prompt")
  createdAt            DateTime     @default(now()) @map("created_at")

  professional         Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@map("visagism_consultations")
}
