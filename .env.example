# App
NODE_ENV=development
PORT=3000
WEB_PORT=5173
JWT_SECRET=super-secret-jwt-key-change-in-production-espejos-2026

# Database (PostgreSQL)
POSTGRES_USER=espejos_user
POSTGRES_PASSWORD=espejos_pass
POSTGRES_DB=espejos_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://espejos_user:espejos_pass@localhost:5432/espejos_db?schema=public

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Storage
GALLERY_UPLOAD_DIR=./uploads/gallery

# Google Calendar (OAuth 2.0 placeholder)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
